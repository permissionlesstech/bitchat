    "app_info.settings.relays.subtitle" : {
      "comment" : "Subtitle explaining what the relay list is for and why someone would add a relay",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما لا تصل شبكة mesh إلى شخص، تنتقل الرسائل الخاصة عبر هذه المرحّلات. المرحّلات المدمجة عناوين معروفة يمكن لمرشّح الشبكة حجبها — لذا يمكنك إضافة مرحّلاتك الخاصة، بما في ذلك عناوين .onion."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "когато mesh мрежата не може да достигне някого, личните съобщения минават през тези релета. вградените са добре известни адреси, които мрежов филтър може да блокира, затова можеш да добавиш свои — включително .onion адреси."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "калі mesh не можа даставіць паведамленне, асабістыя паведамленні ідуць праз гэтыя рэтранслятары. убудаваныя — гэта вядомыя адрасы, якія сеткавы фільтр можа заблакіраваць, таму можна дадаць свае — у тым ліку .onion-адрасы."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মেশ কারও কাছে পৌঁছাতে না পারলে ব্যক্তিগত বার্তা এই রিলেগুলোর মধ্য দিয়ে যায়। বিল্ট-ইন রিলেগুলো সুপরিচিত ঠিকানা, যা নেটওয়ার্ক ফিল্টার আটকে দিতে পারে — তাই আপনি নিজের রিলে যোগ করতে পারেন, .onion ঠিকানাও।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "når mesh-netværket ikke kan nå nogen, sendes private beskeder via disse relays. de indbyggede er velkendte adresser, som et netværksfilter kan blokere, så du kan tilføje dine egne — også .onion-adresser."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "když mesh někoho nezastihne, soukromé zprávy putují přes tato relé. vestavěná relé jsou známé adresy, které může síťový filtr zablokovat, proto si můžeš přidat vlastní — včetně adres .onion."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "quan la mesh no pot arribar a algú, els missatges privats passen per aquests relés. els integrats són adreces conegudes que un filtre de xarxa pot bloquejar, així que pots afegir-ne de propis — fins i tot adreces .onion."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kad mesh ne može nekoga dosegnuti, privatne poruke putuju kroz ove releje. ugrađeni su dobro poznate adrese koje mrežni filtar može blokirati, pa možeš dodati svoje — uključujući .onion adrese."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "wenn das mesh jemanden nicht erreicht, laufen private nachrichten über diese relays. die eingebauten sind bekannte adressen, die ein netzwerkfilter blockieren kann — du kannst also eigene hinzufügen, auch .onion-adressen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "όταν το mesh δεν μπορεί να φτάσει σε κάποιον, τα ιδιωτικά μηνύματα περνούν από αυτούς τους αναμεταδότες. οι ενσωματωμένοι είναι γνωστές διευθύνσεις που ένα φίλτρο δικτύου μπορεί να μπλοκάρει, γι' αυτό μπορείς να προσθέσεις τους δικούς σου — ακόμη και διευθύνσεις .onion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "when the mesh can't reach someone, private messages travel through these relays. the built-in ones are well-known addresses that a network filter can block, so you can add your own — including .onion addresses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cuando el mesh no llega a alguien, los mensajes privados viajan por estos relays. los integrados son direcciones muy conocidas que un filtro de red puede bloquear, así que puedes añadir los tuyos — incluidas direcciones .onion."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kui mesh ei jõua kellegini, liiguvad privaatsõnumid nende releede kaudu. sisseehitatud releed on tuntud aadressid, mida võrgufilter saab blokeerida, seega saad lisada oma — ka .onion-aadresse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی مش به کسی نمی‌رسد، پیام‌های خصوصی از این رله‌ها می‌گذرند. رله‌های داخلی نشانی‌های شناخته‌شده‌ای هستند که یک صافی شبکه می‌تواند مسدودشان کند — پس می‌توانید رله‌های خودتان را اضافه کنید، از جمله نشانی‌های .onion."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kun mesh ei tavoita jotakuta, yksityisviestit kulkevat näiden välityspalvelimien kautta. sisäänrakennetut ovat tunnettuja osoitteita, jotka verkkosuodatin voi estää, joten voit lisätä omiasi — myös .onion-osoitteita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kapag hindi maabot ng mesh ang isang tao, dumadaan ang mga pribadong mensahe sa mga relay na ito. ang mga built-in ay kilalang-kilalang address na kayang harangin ng filter ng network — kaya maaari kang magdagdag ng sarili mo, kasama ang mga .onion address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quand le mesh ne joint pas quelqu'un, les messages privés passent par ces relais. ceux intégrés sont des adresses bien connues qu'un filtre réseau peut bloquer — tu peux donc ajouter les tiens, y compris des adresses .onion."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "nuair nach féidir leis an mesh duine a shroicheadh, téann teachtaireachtaí príobháideacha trí na hathsheachadáin seo. is seoltaí aitheanta iad na cinn ionsuite ar féidir le scagaire líonra iad a bhac, mar sin is féidir leat do chuid féin a chur leis — seoltaí .onion san áireamh."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשה-mesh לא מגיע למישהו, הודעות פרטיות עוברות דרך הממסרים האלה. הממסרים המובנים הם כתובות מוכרות שמסנן רשת יכול לחסום — אפשר להוסיף ממסרים משלך, כולל כתובות .onion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब मेश किसी तक नहीं पहुँच पाता, तब निजी संदेश इन रिले से होकर जाते हैं। अंतर्निर्मित रिले जाने-पहचाने पते हैं जिन्हें नेटवर्क फ़िल्टर रोक सकता है — इसलिए आप अपने रिले जोड़ सकते हैं, .onion पते भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ha a mesh nem ér el valakit, a privát üzenetek ezeken a továbbítókon haladnak át. a beépítettek ismert címek, amelyeket egy hálózati szűrő letilthat, ezért hozzáadhatod a sajátjaidat is — akár .onion címeket."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kad mesh ne može nekoga dosegnuti, privatne poruke putuju kroz ove releje. ugrađeni su dobro poznate adrese koje mrežni filtar može blokirati, pa možeš dodati svoje — uključujući .onion adrese."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "saat mesh tidak bisa menjangkau seseorang, pesan pribadi lewat relay ini. relay bawaan adalah alamat yang sudah dikenal luas dan bisa diblokir filter jaringan — jadi kamu bisa menambahkan relay sendiri, termasuk alamat .onion."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "þegar meshið nær ekki til einhvers fara einkaskilaboð í gegnum þessa endurvarpa. þeir innbyggðu eru þekkt vistföng sem netsía getur lokað á, svo þú getur bætt við þínum eigin — þar á meðal .onion-vistföngum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quando la mesh non raggiunge qualcuno, i messaggi privati passano da questi relay. quelli integrati sono indirizzi molto noti che un filtro di rete può bloccare — puoi quindi aggiungere i tuoi, anche indirizzi .onion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "meshで相手に届かないとき、プライベートメッセージはこれらのリレーを通ります。組み込みのリレーはよく知られたアドレスで、ネットワークのフィルターにブロックされることがあります — 自分のリレー、.onionアドレスも追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mesh로 상대에게 닿지 않으면 비공개 메시지는 이 릴레이를 거칩니다. 기본 릴레이는 널리 알려진 주소여서 네트워크 필터가 차단할 수 있습니다 — 그래서 .onion 주소를 포함해 직접 릴레이를 추가할 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "кога mesh мрежата не може да стигне до некого, приватните пораки патуваат низ овие релеи. вградените се добро познати адреси што мрежен филтер може да ги блокира, па можеш да додадеш свои — вклучувајќи .onion адреси."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kad mesh nevar kādu sasniegt, privātās ziņas ceļo caur šiem relejiem. iebūvētie ir labi zināmas adreses, kuras tīkla filtrs var bloķēt, tāpēc vari pievienot savus — arī .onion adreses."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kai mesh tinklas negali ko nors pasiekti, privačios žinutės keliauja per šiuos retransliatorius. integruoti yra gerai žinomi adresai, kuriuos tinklo filtras gali užblokuoti, todėl gali pridėti savo — taip pat .onion adresus."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "wann de mesh een net erreecht, ginn d'privat noriichten iwwer dës relaisen. déi agebaut si bekannt adressen, déi en netzwierkfilter spären kann, dofir kanns du deng eege relaisen derbäisetzen — och .onion-adressen."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apabila mesh tidak dapat mencapai seseorang, pesan peribadi bergerak melalui relay ini. relay terbina dalam ialah alamat yang terkenal dan boleh dihalang oleh penapis rangkaian — jadi anda boleh menambah relay sendiri, termasuk alamat .onion."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "når mesh-nettet ikke når noen, sendes private meldinger via disse reléene. de innebygde er velkjente adresser som et nettverksfilter kan blokkere, så du kan legge til dine egne — også .onion-adresser."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "meta l-mesh ma jilħaqx lil xi ħadd, il-messaġġi privati jgħaddu minn dawn ir-relays. dawk integrati huma indirizzi magħrufa li filtru tan-netwerk jista' jibblokkahom, għalhekk tista' żżid tiegħek — anke indirizzi .onion."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mesh कसैसम्म पुग्न सक्दैन भने निजी सन्देश यी रिले मार्फत जान्छन्। पूर्वनिर्मित रिले सबैलाई थाहा भएका ठेगाना हुन्, जसलाई नेटवर्क फिल्टरले रोक्न सक्छ — त्यसैले तिमी आफ्नै रिले थप्न सक्छौ, .onion ठेगाना पनि।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "als de mesh iemand niet bereikt, gaan privéberichten via deze relays. de ingebouwde relays zijn bekende adressen die een netwerkfilter kan blokkeren — je kunt dus je eigen relays toevoegen, ook .onion-adressen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gdy mesh nie dosięga kogoś, wiadomości prywatne idą przez te relay. wbudowane to powszechnie znane adresy, które filtr sieciowy może zablokować — możesz więc dodać własne, także adresy .onion."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quando a mesh não chega a alguém, as mensagens privadas seguem por estes relés. os integrados são endereços bem conhecidos que um filtro de rede pode bloquear — por isso podes acrescentar os teus, incluindo endereços .onion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quando o mesh não alcança alguém, as mensagens privadas passam por estes relays. os integrados são endereços conhecidos que um filtro de rede pode bloquear — então você pode adicionar os seus, inclusive endereços .onion."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "când rețeaua mesh nu poate ajunge la cineva, mesajele private trec prin aceste relee. cele integrate sunt adrese cunoscute pe care un filtru de rețea le poate bloca, așa că poți adăuga propriile relee — inclusiv adrese .onion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "когда mesh не достаёт до человека, приватные сообщения идут через эти реле. встроенные — это широко известные адреса, которые может заблокировать сетевой фильтр, поэтому можно добавить свои, в том числе .onion-адреса."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "када mesh не може некога да досегне, приватне поруке путују кроз ове релеје. уграђени су добро познате адресе које мрежни филтер може да блокира, па можеш да додаш своје — укључујући .onion адресе."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kur mesh-i nuk arrin dikë, mesazhet private kalojnë përmes këtyre përcjellësve. ata të integruarit janë adresa të njohura që një filtër rrjeti mund t'i bllokojë, prandaj mund të shtosh të tutë — edhe adresa .onion."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ko mesh nekoga ne doseže, zasebna sporočila potujejo prek teh relejev. vgrajeni so dobro znani naslovi, ki jih lahko omrežni filter blokira, zato lahko dodaš svoje — tudi naslove .onion."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "keď mesh niekoho nezastihne, súkromné správy putujú cez tieto relé. vstavané relé sú známe adresy, ktoré môže sieťový filter zablokovať, preto si môžeš pridať vlastné — vrátane adries .onion."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "när mesh inte når fram till någon går privata meddelanden via dessa reläer. de inbyggda är välkända adresser som ett nätverksfilter kan blockera — du kan därför lägga till egna, även .onion-adresser."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mesh ஒருவரை எட்ட முடியாதபோது, தனிப்பட்ட செய்திகள் இந்த ரிலேகள் வழியாகச் செல்கின்றன. உள்ளமைந்த ரிலேகள் நன்கு அறியப்பட்ட முகவரிகள், அவற்றை நெட்வொர்க் வடிகட்டி தடுக்க முடியும் — எனவே .onion முகவரிகள் உட்பட உங்கள் சொந்த ரிலேகளைச் சேர்க்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อ mesh ไปไม่ถึงใคร ข้อความส่วนตัวจะเดินทางผ่านรีเลย์เหล่านี้ รีเลย์ที่มาพร้อมแอปเป็นที่อยู่ที่รู้จักกันดีและตัวกรองเครือข่ายปิดกั้นได้ — คุณจึงเพิ่มรีเลย์ของตัวเองได้ รวมถึงที่อยู่ .onion"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mesh birine ulaşamadığında özel mesajlar bu rölelerden geçer. yerleşik röleler herkesin bildiği adreslerdir ve bir ağ filtresi bunları engelleyebilir — bu yüzden .onion adresleri de dahil kendi rölelerinizi ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "коли mesh не дотягується до людини, приватні повідомлення йдуть через ці релеї. вбудовані — це добре відомі адреси, які може заблокувати мережевий фільтр, тож можна додати власні, зокрема .onion-адреси."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب mesh کسی تک نہ پہنچ سکے تو نجی پیغامات ان ریلے سے گزرتے ہیں۔ بلٹ اِن ریلے مشہور پتے ہیں جنہیں نیٹ ورک فلٹر روک سکتا ہے — اس لیے آپ اپنے ریلے شامل کر سکتے ہیں، .onion پتے بھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "khi mesh không tới được ai đó, tin nhắn riêng đi qua các relay này. các relay tích hợp là những địa chỉ ai cũng biết nên bộ lọc mạng có thể chặn — vì vậy bạn có thể thêm relay của mình, kể cả địa chỉ .onion."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 mesh 无法触达某人时，私密消息会经这些中继传递。内置中继是众所周知的地址，网络过滤可以封锁它们 — 所以你可以添加自己的中继，包括 .onion 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 mesh 無法觸及某人時，私密訊息會經這些中繼傳遞。內建中繼是眾所周知的位址，網路過濾可以封鎖它們 — 所以你可以加入自己的中繼，包括 .onion 位址。"
          }
        }
      }
    },
