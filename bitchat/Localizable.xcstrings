    "content.accessibility.record_voice_hint" : {
      "comment" : "Accessibility hint explaining double-tap toggles voice recording",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط ضغطة مزدوجة لبدء التسجيل، واضغط مرة أخرى للإرسال"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "докосни два пъти, за да започнеш запис, и отново два пъти, за да изпратиш"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "двойчы націсні, каб пачаць запіс, і яшчэ раз двойчы, каб адправіць"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "রেকর্ডিং শুরু করতে দুইবার ট্যাপ করুন, পাঠাতে আবার দুইবার ট্যাপ করুন"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tryk to gange for at starte optagelsen, tryk to gange igen for at sende"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dvojitým klepnutím spustíš nahrávání, dalším dvojitým klepnutím odešleš"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "toca dues vegades per començar a gravar, i dues vegades més per enviar"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dvaput dodirni za početak snimanja, ponovo dvaput dodirni za slanje"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "doppeltippen zum aufnehmen, erneut doppeltippen zum senden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "πάτησε δύο φορές για έναρξη ηχογράφησης, ξανά δύο φορές για αποστολή"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "double-tap to start recording, double-tap again to send"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toca dos veces para empezar a grabar, toca dos veces de nuevo para enviar"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "topeltpuudutus alustab salvestamist, uus topeltpuudutus saadab"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای شروع ضبط دوبار ضربه بزنید، برای ارسال دوباره دوبار ضربه بزنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "aloita tallennus kaksoisnapauttamalla, lähetä kaksoisnapauttamalla uudelleen"
          }
