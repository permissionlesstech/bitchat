    "command.pay.invalid" : {
      "comment" : "Error when /pay input fails to decode",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز cashu غير صالح — لا يمكن فك ترميزه إلى رمز معروف بمبلغ، لن يتم إرساله"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "невалиден cashu токен — не се декодира до познат токен със сума, няма да бъде изпратен"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "несапраўдны cashu токен — яго нельга дэкадаваць у вядомы токен з сумай, ён не будзе адпраўлены"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবৈধ cashu টোকেন — পরিমাণসহ কোনো পরিচিত টোকেনে ডিকোড হচ্ছে না, পাঠানো হচ্ছে না"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
