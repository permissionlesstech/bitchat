    "location_channels.grant_to_find" : {
      "comment" : "Hint shown in the channel list instead of a loading spinner when location permission is missing",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح إذن الموقع للعثور على القنوات القريبة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "разреши достъп до местоположението, за да намериш близки канали"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "дай доступ да месцазнаходжання, каб знайсці каналы побач"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাছাকাছি চ্যানেল খুঁজতে অবস্থানের অনুমতি দিন"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "giv placeringsadgang for at finde kanaler i nærheden"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "povol přístup k poloze pro nalezení kanálů poblíž"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "concedeix accés a la ubicació per trobar canals propers"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dozvoli pristup lokaciji za pronalaženje obližnjih kanala"
          }
        },
        "de" : {
