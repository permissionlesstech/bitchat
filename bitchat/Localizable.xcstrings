    "system.location.not_in_channel" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الإرسال: لست داخل قناة موقع"
          }
        },
        "bg" : {
          "stringUnit" : {
