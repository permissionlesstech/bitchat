    "channel.share.precision_warning.message" : {
      "comment" : "Body of the confirmation before sharing a fine-precision geohash invite",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغطي هذه القناة منطقة صغيرة. الدعوة عبر الرسائل أو imessage تظهر لمشغّل الشبكة والجهازين — وتكشف الاهتمام بذلك المكان، وليس فقط أن شخصًا يستخدم bitchat."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "този канал покрива малък район. покана, изпратена по sms или imessage, е видима за оператора и за двата телефона — тя разкрива интерес към това място, а не само че някой използва bitchat."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "гэты канал ахоплівае невялікі раён. запрашэнне праз sms або imessage бачаць аператар і абодва тэлефоны — яно раскрывае цікавасць да гэтага месца, а не толькі тое, што нехта карыстаецца bitchat."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই চ্যানেলটি ছোট এলাকা জুড়ে। sms বা imessage-এ পাঠানো আমন্ত্রণ ক্যারিয়ার ও দুই হ্যান্ডসেটে দেখা যায় — এতে bitchat ব্যবহারের পাশাপাশি সেই জায়গায় আগ্রহও প্রকাশ পায়।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "denne kanal dækker et lille område. en invitation sendt via sms eller imessage er synlig for operatøren og begge telefoner — den afslører interesse for stedet, ikke kun at nogen bruger bitchat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tento kanál pokrývá malou oblast. pozvánka poslaná přes sms nebo imessage je viditelná operátorovi i oběma telefonům — prozrazuje zájem o to místo, nejen to, že někdo používá bitchat."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "aquest canal cobreix una zona petita. una invitació enviada per sms o imessage és visible per a l'operador i per als dos telèfons — revela interès per aquell lloc, no només que algú fa servir bitchat."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ovaj kanal pokriva malo područje. pozivnica poslana putem sms-a ili imessagea vidljiva je operateru i oba telefona — otkriva zanimanje za to mjesto, a ne samo da neko koristi bitchat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dieser kanal deckt ein kleines gebiet ab. eine einladung per sms oder imessage ist für den netzanbieter und beide geräte sichtbar — sie verrät interesse an diesem ort, nicht nur dass jemand bitchat nutzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "αυτό το κανάλι καλύπτει μικρή περιοχή. μια πρόσκληση μέσω sms ή imessage είναι ορατή στον πάροχο και στις δύο συσκευές — φανερώνει ενδιαφέρον για το συγκεκριμένο μέρος, όχι μόνο ότι κάποιος χρησιμοποιεί το bitchat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "this channel covers a small area. an invite sent over sms or imessage is visible to the carrier and both handsets — it discloses interest in that place, not only that someone uses bitchat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "este canal cubre un área pequeña. una invitación enviada por sms o imessage es visible para el operador y ambos teléfonos — revela interés en ese lugar, no solo que alguien usa bitchat."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "see kanal katab väikest ala. sms-i või imessage'i teel saadetud kutse on nähtav operaatorile ja mõlemale telefonile — see paljastab huvi selle koha vastu, mitte ainult seda, et keegi kasutab bitchati."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کانال ناحیه کوچکی را پوشش می‌دهد. دعوت‌نامهٔ sms یا imessage برای اپراتور و هر دو دستگاه دیده می‌شود — علاقه به آن مکان را فاش می‌کند، نه فقط اینکه کسی از bitchat استفاده می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tämä kanava kattaa pienen alueen. tekstiviestillä tai imessagella lähetetty kutsu näkyy operaattorille ja molemmille laitteille — se paljastaa kiinnostuksen paikkaan, ei vain sitä, että joku käyttää bitchatia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
