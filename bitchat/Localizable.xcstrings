    "app_info.settings.hide_previews.subtitle" : {
      "comment" : "Subtitle explaining what hiding notification message previews does",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقول الإشعارات إن شيئًا ما وصل دون إظهار الرسالة ولا من أرسلها ولا قناة الموقع التي جاءت منها. من يحمل هاتفك المقفل لا يعرف شيئًا من شاشة القفل. مفعّل افتراضيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "известията казват, че нещо е пристигнало, без да показват съобщението, подателя или канала, от който е дошло. който държи заключения ти телефон, не научава нищо от заключения екран. включено по подразбиране."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "апавяшчэнні паведамляюць, што нешта прыйшло, не паказваючы паведамлення, адпраўніка ці канала. той, хто трымае твой заблакіраваны тэлефон, нічога не даведаецца з экрана блакіроўкі. уключана па змаўчанні."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটিফিকেশন শুধু জানায় যে কিছু এসেছে — বার্তা, কে পাঠিয়েছে বা কোন লোকেশন চ্যানেল থেকে এসেছে তা দেখায় না। আপনার লক করা ফোন যার হাতেই থাকুক, লক স্ক্রিন থেকে কিছুই জানতে পারবে না। ডিফল্টভাবে চালু।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "notifikationer siger, at der er kommet noget, uden at vise beskeden, hvem der sendte den, eller hvilken lokationskanal den kom fra. den, der har din låste telefon, lærer intet fra låseskærmen. slået til som standard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "oznámení řeknou, že něco přišlo, aniž by ukázala zprávu, odesílatele nebo kanál polohy, ze kterého přišla. kdo drží tvůj zamčený telefon, se ze zamčené obrazovky nic nedozví. ve výchozím stavu zapnuto."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "les notificacions diuen que ha arribat alguna cosa sense mostrar el missatge, qui l'ha enviat ni de quin canal d'ubicació ve. qui tingui el teu telèfon bloquejat no sabrà res per la pantalla de bloqueig. activat per defecte."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "obavijesti kažu da je nešto stiglo bez prikaza poruke, pošiljaoca ili lokacijskog kanala iz kojeg je došla. ko drži tvoj zaključani telefon ne saznaje ništa sa zaključanog ekrana. uključeno prema zadanim postavkama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "benachrichtigungen sagen nur, dass etwas angekommen ist — ohne die nachricht, ohne wer sie geschickt hat und ohne den standortkanal, aus dem sie kam. wer dein gesperrtes handy in der hand hält, erfährt vom sperrbildschirm nichts. standardmäßig an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "οι ειδοποιήσεις λένε ότι κάτι έφτασε χωρίς να δείχνουν το μήνυμα, ποιος το έστειλε ή από ποιο κανάλι τοποθεσίας ήρθε. όποιος κρατά το κλειδωμένο τηλέφωνό σου δεν μαθαίνει τίποτα από την οθόνη κλειδώματος. ενεργό από προεπιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "notifications say that something arrived without showing the message, who sent it, or which location channel it came from. anyone holding your locked phone learns nothing from the lock screen. on by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "las notificaciones dicen que ha llegado algo sin mostrar el mensaje, quién lo envió ni de qué canal de ubicación viene. quien tenga tu teléfono bloqueado en la mano no aprende nada de la pantalla de bloqueo. activado por defecto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "teavitused ütlevad, et midagi saabus, näitamata sõnumit, saatjat ega asukohakanalit, kust see tuli. keegi, kes hoiab su lukustatud telefoni, ei saa lukustuskuvalt midagi teada. vaikimisi sees."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها فقط می‌گویند چیزی رسیده است، بدون نشان دادن متن پیام، فرستنده یا کانال موقعیتی که از آن آمده. هر کسی گوشی قفل‌شده‌ات را در دست بگیرد، از صفحهٔ قفل چیزی نمی‌فهمد. به‌طور پیش‌فرض روشن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ilmoitukset kertovat, että jotain saapui, näyttämättä viestiä, lähettäjää tai sijaintikanavaa. lukitun puhelimesi haltija ei saa lukitusnäytöltä mitään tietoa. oletuksena päällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sinasabi lang ng mga notification na may dumating, hindi ang mensahe, hindi kung sino ang nagpadala, at hindi kung saang channel ng lokasyon ito nanggaling. kahit sino ang may hawak ng naka-lock na telepono mo, wala siyang malalaman sa lock screen. naka-on bilang default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
