          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "брише све поруке, кључеве и идентитет. троструки додир логотипа bitchat/ ради исто."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fshin të gjitha mesazhet, çelësat dhe identitetin. prekja tri herë e logos bitchat/ bën të njëjtën gjë."
