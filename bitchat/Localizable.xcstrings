    "app_info.location.notes.description" : {
      "comment" : "Description of the location notes toggle in app info",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت ملاحظات في الأماكن باستخدام /drop، يقرؤها أي مارّ خلال 24 ساعة. يتطلب الموقع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "закачай бележки на места с /drop; всеки минувач може да ги чете 24 ч. нужно е местоположение."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "замацоўвай нататкі на месцах праз /drop; кожны, хто праходзіць міма, можа чытаць іх 24 г. патрэбна месцазнаходжанне."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/drop দিয়ে জায়গায় নোট পিন করুন, 24 ঘণ্টা ধরে পাশ দিয়ে যাওয়া যে কেউ পড়তে পারবে। অবস্থান প্রয়োজন।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fastgør noter til steder med /drop, læsbare for alle, der kommer forbi, i 24 t. kræver placering."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "připínej poznámky k místům pomocí /drop; 24 h si je přečte každý, kdo jde kolem. vyžaduje polohu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fixa notes en llocs amb /drop, que qualsevol que hi passi pot llegir durant 24 h. cal la ubicació."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "zakači bilješke na mjesta pomoću /drop; svako ko prolazi može ih čitati 24 h. treba lokaciju."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hefte notizen mit /drop an orte, 24h lesbar für alle, die vorbeikommen. benötigt standort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "καρφίτσωσε σημειώσεις σε μέρη με /drop, που μπορεί να τις διαβάσει για 24 ώρες όποιος περνά από εκεί. χρειάζεται τοποθεσία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pin notes to places with /drop, readable by anyone passing by for 24h. needs location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fija notas en lugares con /drop, legibles por cualquiera que pase durante 24h. necesita ubicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kinnita käsuga /drop kohtadesse märkmeid, mida kõik möödujad saavad 24 tundi lugeda. vajab asukohta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با /drop یادداشت به مکان‌ها سنجاق کن؛ هر رهگذری تا ۲۴ ساعت می‌تواند بخواند. به موقعیت نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kiinnitä muistiinpanoja paikkoihin komennolla /drop; kaikki ohikulkijat voivat lukea ne 24 tunnin ajan. vaatii sijainnin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mag-pin ng mga note sa mga lugar gamit ang /drop, mababasa ng sinumang dadaan sa loob ng 24h. kailangan ng lokasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "épinglez des notes à des lieux avec /drop, lisibles par quiconque passe pendant 24h. nécessite la localisation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pionnáil nótaí ar áiteanna le /drop, le léamh ag aon duine a théann thart ar feadh 24 uair. teastaíonn suíomh."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצמד פתקים למקומות עם /drop, קריאים לכל מי שעובר במשך 24 שעות. דורש מיקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/drop से जगहों पर नोट पिन करें, 24 घंटे तक वहां से गुजरने वाला कोई भी पढ़ सकता है। स्थान आवश्यक।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tűzz ki jegyzeteket helyekre a /drop paranccsal, amelyeket 24 óráig bárki elolvashat, aki arra jár. helymeghatározás kell hozzá."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "prikvači bilješke na mjesta pomoću /drop; svatko tko prolazi može ih čitati 24 h. treba lokaciju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sematkan catatan di tempat dengan /drop, dapat dibaca siapa pun yang lewat selama 24 jam. perlu lokasi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "festu miða á staði með /drop, læsilega öllum sem eiga leið hjá í 24 klst. þarf staðsetningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fissa note nei luoghi con /drop, leggibili da chiunque passi per 24h. richiede la posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/drop で場所にメモをピン留め。24時間、通りかかった誰でも読めます。位置情報が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/drop로 장소에 메모를 고정하세요. 24시간 동안 지나가는 누구나 읽을 수 있습니다. 위치 필요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "закачувај белешки на места со /drop; секој минувач може да ги чита 24 ч. потребна е локација."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
