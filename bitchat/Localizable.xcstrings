    "location_channels.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دردش مع من حولك عبر قنوات geohash. الـ geohash المحدد علني وقد يكشف منطقة تقريبية؛ لا تتم مشاركة إحداثيات GPS الدقيقة أبدًا. مع تشغيل tor (الوضع الافتراضي)، ترى المرحّلات عنوان tor بدلاً من عنوان IP الخاص بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "чати с хора наблизо чрез geohash канали. избраният geohash е публичен и може да разкрие приблизителен район; точният GPS никога не се споделя. когато tor е включен (по подразбиране), релетата виждат адреса на tor вместо IP адреса ти."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "размаўляй з людзьмі побач праз geohash-каналы. выбраны geohash публічны і можа раскрыць прыблізны раён; дакладны GPS ніколі не раскрываецца. калі tor уключаны (па змаўчанні), рэтранслятары бачаць адрас tor замест твайго IP-адраса."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash চ্যানেল ব্যবহার করে কাছের মানুষদের সঙ্গে চ্যাট করুন। নির্বাচিত geohash সর্বজনীন এবং আনুমানিক এলাকা প্রকাশ করতে পারে; সঠিক GPS কখনও শেয়ার হয় না। tor চালু থাকলে (ডিফল্ট), রিলেগুলো আপনার IP-এর বদলে tor-এর ঠিকানা দেখে।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "chat med folk i nærheden via geohash-kanaler. den valgte geohash er offentlig og kan afsløre et omtrentligt område; præcis GPS deles aldrig. med tor slået til (standard) ser relays tors adresse i stedet for din IP-adresse."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "chatuj s lidmi poblíž pomocí geohash kanálů. zvolený geohash je veřejný a může prozradit přibližnou oblast; přesná GPS poloha se nikdy nesdílí. se zapnutým torem (výchozí) vidí relé adresu toru místo tvé IP adresy."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xateja amb la gent propera amb canals geohash. el geohash seleccionat és públic i pot revelar una zona aproximada; la ubicació GPS exacta no es comparteix mai. amb tor activat (per defecte), els relés veuen l'adreça de tor en lloc de la teva adreça IP."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "razgovaraj s ljudima u blizini putem geohash kanala. odabrani geohash je javan i može otkriti približno područje; tačna GPS lokacija se nikad ne dijeli. kad je tor uključen (zadano), releji vide torovu adresu umjesto tvoje IP adrese."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chatte mit leuten in deiner nähe über geohash-kanäle. der gewählte geohash ist öffentlich und kann ein ungefähres gebiet verraten; exaktes GPS wird nie geteilt. mit eingeschaltetem tor (standard) sehen relays tors adresse statt deiner IP-adresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "συνομίλησε με άτομα κοντά σου μέσω καναλιών geohash. το επιλεγμένο geohash είναι δημόσιο και μπορεί να αποκαλύψει μια κατά προσέγγιση περιοχή· η ακριβής θέση GPS δεν κοινοποιείται ποτέ. με το tor ενεργό (προεπιλογή), οι αναμεταδότες βλέπουν τη διεύθυνση του tor αντί για τη διεύθυνση IP σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chat with people near you using geohash channels. the selected geohash is public and may reveal an approximate area; exact GPS is never shared. with tor on (the default), relays see tor's address instead of your IP address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chatea con gente cercana usando canales geohash. el geohash seleccionado es público y puede revelar una zona aproximada; el GPS exacto nunca se comparte. con tor activado (el valor predeterminado), los relés ven la dirección de tor en lugar de tu IP."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "vestle lähedal olevate inimestega geohash-kanalite kaudu. valitud geohash on avalik ja võib paljastada ligikaudse piirkonna; täpset GPS-asukohta ei jagata kunagi. kui tor on sees (vaikimisi), näevad releed tori aadressi, mitte sinu IP-aadressi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با افراد نزدیک خود از طریق کانال‌های geohash گفتگو کنید. geohash انتخابی عمومی است و ممکن است منطقه‌ای تقریبی را نشان دهد؛ GPS دقیق هرگز به اشتراک گذاشته نمی‌شود. با روشن بودن tor (پیش‌فرض)، رله‌ها به جای IP شما آدرس tor را می‌بینند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "keskustele lähelläsi olevien ihmisten kanssa geohash-kanavilla. valittu geohash on julkinen ja voi paljastaa likimääräisen alueen; tarkkaa GPS-sijaintia ei koskaan jaeta. kun tor on päällä (oletus), välityspalvelimet näkevät torin osoitteen IP-osoitteesi sijaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "makipag-chat sa mga taong malapit sa iyo gamit ang mga geohash channel. pampubliko ang napiling geohash at maaaring magbunyag ng tinatayang lugar; hindi kailanman ibinabahagi ang eksaktong GPS. kapag naka-on ang tor (ang default), ang address ng tor ang nakikita ng mga relay sa halip na ang iyong IP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "discutez avec les gens autour de vous via les canaux geohash. le geohash choisi est public et peut révéler une zone approximative ; le GPS exact n'est jamais partagé. avec tor activé (par défaut), les relais voient l'adresse de tor au lieu de votre IP."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "déan comhrá le daoine in aice leat le cainéil geohash. tá an geohash roghnaithe poiblí agus d'fhéadfadh sé limistéar garbh a nochtadh; ní roinntear GPS beacht riamh. le tor ar siúl (réamhshocrú), feiceann athsheachadáin seoladh tor in áit do sheolta IP."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שוחחו עם אנשים בסביבה דרך ערוצי geohash. ה-geohash שנבחר הוא ציבורי ועשוי לחשוף אזור משוער; מיקום GPS מדויק לעולם לא משותף. כש-tor פועל (ברירת המחדל), הממסרים רואים את הכתובת של tor במקום ה-IP שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash चैनलों के ज़रिए आस-पास के लोगों से चैट करें। चुना गया geohash सार्वजनिक है और अनुमानित क्षेत्र दिखा सकता है; सटीक GPS कभी साझा नहीं होता। tor चालू होने पर (डिफ़ॉल्ट), रिले आपके IP की जगह tor का पता देखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "csevegj a közeledben lévőkkel geohash-csatornákon. a kiválasztott geohash nyilvános, és hozzávetőleges területet árulhat el; a pontos GPS-hely soha nem kerül megosztásra. bekapcsolt torral (alapértelmezés) a továbbítók a tor címét látják az IP-címed helyett."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "razgovaraj s ljudima u blizini putem geohash kanala. odabrani geohash je javan i može otkriti približno područje; točna GPS lokacija se nikad ne dijeli. kad je tor uključen (zadano), releji vide torovu adresu umjesto tvoje IP adrese."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mengobrol dengan orang di sekitar melalui kanal geohash. geohash yang dipilih bersifat publik dan dapat mengungkap area perkiraan; GPS persis tidak pernah dibagikan. dengan tor aktif (bawaan), relay melihat alamat tor alih-alih IP anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "spjallaðu við fólk nálægt þér með geohash-rásum. valið geohash er opinbert og getur afhjúpað áætlað svæði; nákvæm GPS-staðsetning er aldrei deilt. þegar kveikt er á tor (sjálfgefið) sjá endurvarpar vistfang tor í stað IP-tölunnar þinnar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chatta con chi ti sta vicino usando i canali geohash. il geohash selezionato è pubblico e può rivelare un'area approssimativa; il GPS esatto non viene mai condiviso. con tor attivo (impostazione predefinita), i relay vedono l'indirizzo di tor invece del tuo IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash チャンネルで近くの人とチャットできます。選択した geohash は公開され、おおよそのエリアが分かる場合があります。正確な GPS は決して共有されません。tor が有効（デフォルト）なら、リレーにはあなたの IP ではなく tor のアドレスが見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash 채널로 주변 사람들과 대화하세요. 선택한 geohash는 공개되며 대략적인 지역이 드러날 수 있습니다. 정확한 GPS는 절대 공유되지 않습니다. tor가 켜져 있으면(기본값) 릴레이에는 내 IP 대신 tor의 주소가 보입니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "разговарај со луѓе во близина преку geohash канали. избраниот geohash е јавен и може да открие приближна област; точната GPS локација никогаш не се споделува. кога tor е вклучен (стандардно), релеите ја гледаат адресата на tor наместо твојата IP адреса."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tērzē ar cilvēkiem tev tuvumā, izmantojot geohash kanālus. izvēlētais geohash ir publisks un var atklāt aptuvenu apkaimi; precīza GPS atrašanās vieta nekad netiek kopīgota. kad tor ir ieslēgts (pēc noklusējuma), releji redz tor adresi, nevis tavu IP adresi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kalbėkis su netoliese esančiais žmonėmis per geohash kanalus. pasirinktas geohash yra viešas ir gali atskleisti apytikslę apylinkę; tiksli GPS vieta niekada nebendrinama. kai tor įjungtas (numatytasis), retransliatoriai mato tor adresą, o ne tavo IP adresą."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "chat mat leit an denger géigend iwwer geohash-kanäl. de gewielte geohash ass ëffentlech a kann eng ongeféier zone verroden; den exakte GPS gëtt ni gedeelt. mat tor un (standard) gesinn d'relaisen dem tor seng adress amplaz vun denger IP-adress."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "berbual dengan orang berdekatan melalui saluran geohash. geohash yang dipilih adalah umum dan mungkin mendedahkan kawasan anggaran; GPS tepat tidak pernah dikongsi. dengan tor dihidupkan (lalai), relay melihat alamat tor dan bukan IP anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "chat med folk i nærheten via geohash-kanaler. den valgte geohashen er offentlig og kan avsløre et omtrentlig område; nøyaktig GPS deles aldri. med tor på (standard) ser reléene tor sin adresse i stedet for IP-adressen din."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iċċettja ma' nies qrib tiegħek permezz ta' kanali geohash. il-geohash magħżul huwa pubbliku u jista' jiżvela żona approssimattiva; il-post GPS eżatt qatt ma jinqasam. b'tor mixgħul (default), ir-relays jaraw l-indirizz ta' tor minflok l-indirizz IP tiegħek."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash च्यानलहरू प्रयोग गरेर नजिकका मानिसहरूसँग कुराकानी गर्नुहोस्। चयन गरिएको geohash सार्वजनिक हुन्छ र अनुमानित क्षेत्र देखाउन सक्छ; सटीक GPS कहिल्यै साझा हुँदैन। tor खुला हुँदा (पूर्वनिर्धारित), रिलेहरूले तपाईंको IP को सट्टा tor को ठेगाना देख्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chat met mensen in de buurt via geohash-kanalen. de gekozen geohash is openbaar en kan een globaal gebied onthullen; exacte GPS wordt nooit gedeeld. met tor aan (standaard) zien relays het adres van tor in plaats van je IP-adres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rozmawiaj z ludźmi w pobliżu przez kanały geohash. wybrany geohash jest publiczny i może zdradzić przybliżony obszar; dokładny GPS nigdy nie jest udostępniany. przy włączonym tor (domyślnie) przekaźniki widzą adres tora zamiast twojego IP."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "conversa com pessoas por perto através de canais geohash. o geohash selecionado é público e pode revelar uma área aproximada; o GPS exato nunca é partilhado. com o tor ligado (predefinição), os relays veem o endereço do tor em vez do teu IP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "converse com pessoas por perto usando canais geohash. o geohash selecionado é público e pode revelar uma área aproximada; o GPS exato nunca é compartilhado. com o tor ligado (padrão), os relays veem o endereço do tor em vez do seu IP."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "discută cu oamenii din apropiere prin canale geohash. geohash-ul selectat este public și poate dezvălui o zonă aproximativă; locația GPS exactă nu este niciodată partajată. cu tor pornit (implicit), releele văd adresa tor în locul adresei tale IP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "общайтесь с людьми поблизости через geohash-каналы. выбранный geohash публичен и может раскрыть примерный район; точные GPS-координаты никогда не передаются. при включённом tor (по умолчанию) релеи видят адрес tor вместо вашего IP."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "разговарај са људима у близини преко geohash канала. изабрани geohash је јаван и може да открије приближно подручје; тачна GPS локација се никад не дели. када је tor укључен (подразумевано), релеји виде tor адресу уместо твоје IP адресе."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "bisedo me njerëz afër teje përmes kanaleve geohash. geohash-i i zgjedhur është publik dhe mund të zbulojë një zonë të përafërt; vendndodhja e saktë GPS nuk ndahet kurrë. me tor-in aktiv (parazgjedhja), përcjellësit shohin adresën e tor-it në vend të adresës tënde IP."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "klepetaj z ljudmi v bližini prek geohash kanalov. izbrani geohash je javen in lahko razkrije približno območje; natančna GPS lokacija se nikoli ne deli. ko je tor vklopljen (privzeto), releji vidijo torov naslov namesto tvojega naslova IP."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "chatuj s ľuďmi nablízku pomocou geohash kanálov. zvolený geohash je verejný a môže prezradiť približnú oblasť; presná GPS poloha sa nikdy nezdieľa. so zapnutým torom (predvolené) vidia relé adresu toru namiesto tvojej IP adresy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chatta med folk i närheten via geohash-kanaler. vald geohash är offentlig och kan avslöja ett ungefärligt område; exakt GPS delas aldrig. med tor på (standard) ser reläer tors adress istället för din IP."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash சேனல்கள் மூலம் அருகிலுள்ளவர்களுடன் அரட்டையடிக்கவும். தேர்ந்தெடுத்த geohash பொதுவானது, தோராயமான பகுதியை வெளிப்படுத்தலாம்; துல்லியமான GPS ஒருபோதும் பகிரப்படாது. tor இயக்கத்தில் இருந்தால் (இயல்புநிலை), ரிலேக்கள் உங்கள் IP க்குப் பதிலாக tor இன் முகவரியைக் காண்கின்றன."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทกับผู้คนใกล้ตัวผ่านช่อง geohash โดย geohash ที่เลือกเป็นแบบสาธารณะและอาจเผยพื้นที่โดยประมาณ พิกัด GPS ที่แน่นอนจะไม่ถูกแชร์ เมื่อเปิด tor (ค่าเริ่มต้น) รีเลย์จะเห็นที่อยู่ของ tor แทน IP ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash kanallarıyla yakınınızdaki insanlarla sohbet edin. seçilen geohash herkese açıktır ve yaklaşık bir bölgeyi açığa çıkarabilir; tam GPS asla paylaşılmaz. tor açıkken (varsayılan) röleler IP'niz yerine tor'un adresini görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "спілкуйтеся з людьми поруч через geohash-канали. вибраний geohash є публічним і може розкрити приблизний район; точні GPS-координати ніколи не передаються. з увімкненим tor (типово) релеї бачать адресу tor замість вашого IP."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geohash چینلز کے ذریعے قریبی لوگوں سے چیٹ کریں۔ منتخب geohash عوامی ہے اور تخمینی علاقہ ظاہر کر سکتا ہے؛ درست GPS کبھی شیئر نہیں ہوتا۔ tor آن ہونے پر (ڈیفالٹ)، ریلے آپ کے IP کی بجائے tor کا پتہ دیکھتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "trò chuyện với những người gần bạn qua các kênh geohash. geohash đã chọn là công khai và có thể tiết lộ khu vực gần đúng; GPS chính xác không bao giờ được chia sẻ. khi bật tor (mặc định), các relay thấy địa chỉ của tor thay vì IP của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 geohash 频道与附近的人聊天。所选 geohash 是公开的，可能暴露大致区域；精确 GPS 绝不会被共享。开启 tor 时（默认），中继看到的是 tor 的地址而不是你的 IP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 geohash 頻道與附近的人聊天。所選 geohash 是公開的，可能透露大致區域；精確 GPS 絕不會被分享。開啟 tor 時（預設），中繼看到的是 tor 的位址而不是你的 IP。"
          }
        }
      }
    },
