    "app_info.voice.live.description" : {
      "comment" : "Description of the live voice messages setting",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبث أثناء التحدث؛ الصوت المباشر الوارد يُشغَّل تلقائيًا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "предава се, докато говориш; входящият глас на живо се пуска автоматично"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "трансліруецца, пакуль ты гаворыш; уваходны жывы голас прайграецца аўтаматычна"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথা বলার সাথে সাথে স্ট্রিম হয়; আগত লাইভ ভয়েস স্বয়ংক্রিয়ভাবে চলে"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "streames, mens du taler; indgående live-tale afspilles automatisk"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "streamuje se, zatímco mluvíš; příchozí živý hlas se přehraje automaticky"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "es transmet mentre parles; la veu en directe que arriba es reprodueix automàticament"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "prenosi se dok govoriš; dolazni glas uživo reproducira se automatski"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "überträgt live beim sprechen; eingehende live-stimme wird automatisch abgespielt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "μεταδίδεται όσο μιλάς· η εισερχόμενη ζωντανή φωνή παίζει αυτόματα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "streams as you speak; incoming live voice plays automatically"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "transmite mientras hablas; la voz en vivo entrante se reproduce automáticamente"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "voogedastatakse rääkimise ajal; sissetulev otseheli mängitakse automaatselt"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همان‌طور که حرف می‌زنی پخش می‌شود؛ صدای زندهٔ دریافتی خودکار پخش می‌شود"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "suoratoistetaan puhuessasi; saapuva live-ääni toistetaan automaattisesti"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nag-i-stream habang nagsasalita ka; awtomatikong tumutugtog ang papasok na live na boses"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diffuse pendant que vous parlez ; la voix en direct entrante est lue automatiquement"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "craoltar é agus tú ag caint; seinntear guth beo isteach go huathoibríoch"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משדר בזמן שאתה מדבר; קול חי נכנס מושמע אוטומטית"
          }
        },
