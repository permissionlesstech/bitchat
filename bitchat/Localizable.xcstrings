    "app_info.settings.danger.panic_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح جميع الرسائل والمفاتيح والهوية. النقر ثلاث مرات على شعار bitchat/ يفعل الشيء نفسه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "изтрива всички съобщения, ключове и самоличност. тройното докосване на логото bitchat/ прави същото."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "сцірае ўсе паведамленні, ключы і асобу. тройчы націснуць на лагатып bitchat/ — тое самае."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব বার্তা, কী এবং পরিচয় মুছে ফেলে। bitchat/ লোগোতে তিনবার ট্যাপ করলেও একই কাজ হয়।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "sletter alle beskeder, nøgler og identitet. at trykke tre gange på bitchat/-logoet gør det samme."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "vymaže všechny zprávy, klíče a identitu. trojité klepnutí na logo bitchat/ udělá totéž."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "esborra tots els missatges, les claus i la identitat. tocar tres vegades el logotip bitchat/ fa el mateix."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "briše sve poruke, ključeve i identitet. trostruki dodir logotipa bitchat/ čini isto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "löscht alle nachrichten, schlüssel und die identität. dreimaliges tippen aufs bitchat/-logo macht dasselbe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "διαγράφει όλα τα μηνύματα, τα κλειδιά και την ταυτότητα. το ίδιο κάνει και το τριπλό πάτημα στο λογότυπο bitchat/."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erases all messages, keys, and identity. triple-tapping the bitchat/ logo does the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "borra todos los mensajes, claves e identidad. tocar tres veces el logo de bitchat/ hace lo mismo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kustutab kõik sõnumid, võtmed ja identiteedi. bitchat/-logo kolmekordne puudutamine teeb sama."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه پیام‌ها، کلیدها و هویت را پاک می‌کند. سه بار زدن روی لوگوی bitchat/ همین کار را می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "poistaa kaikki viestit, avaimet ja henkilöllisyyden. bitchat/-logon napauttaminen kolmesti tekee saman."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "binubura ang lahat ng mensahe, key, at pagkakakilanlan. ganoon din ang mangyayari kapag na-tap nang tatlong beses ang bitchat/ logo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "efface tous les messages, les clés et l'identité. toucher trois fois le logo bitchat/ fait la même chose."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "scriosann sé gach teachtaireacht, eochair agus an t-aitheantas. déanann tapáil trí huaire ar an lógó bitchat/ an rud céanna."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק את כל ההודעות, המפתחות והזהות. הקשה משולשת על הלוגו של bitchat/ עושה את אותו הדבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी संदेश, कुंजियाँ और पहचान मिटा देता है। bitchat/ लोगो पर तीन बार टैप करने से भी यही होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "törli az összes üzenetet, kulcsot és a személyazonosságot. a bitchat/ logóra koppintás háromszor ugyanezt teszi."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "briše sve poruke, ključeve i identitet. trostruki dodir logotipa bitchat/ čini isto."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "menghapus semua pesan, kunci, dan identitas. mengetuk logo bitchat/ tiga kali melakukan hal yang sama."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "eyðir öllum skilaboðum, lyklum og auðkenni. að ýta þrisvar á bitchat/-merkið gerir það sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cancella tutti i messaggi, le chiavi e l'identità. toccare tre volte il logo bitchat/ fa lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのメッセージ・鍵・アイデンティティを消去します。bitchat/ ロゴの3回タップでも同じことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 메시지, 키, 신원을 지웁니다. bitchat/ 로고를 세 번 탭해도 동일합니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ги брише сите пораки, клучеви и идентитетот. трикратниот допир на логото bitchat/ го прави истото."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "izdzēš visas ziņas, atslēgas un identitāti. trīsreiz pieskaroties bitchat/ logotipam, notiek tas pats."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ištrina visas žinutes, raktus ir tapatybę. tris kartus bakstelėjus bitchat/ logotipą, nutinka tas pats."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "läscht all noriichten, schlësselen an d'identitéit. dräimol op de bitchat/-logo tippe mécht datselwecht."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "memadamkan semua mesej, kunci dan identiti. mengetik logo bitchat/ tiga kali melakukan perkara yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "sletter alle meldinger, nøkler og identitet. å trykke tre ganger på bitchat/-logoen gjør det samme."
