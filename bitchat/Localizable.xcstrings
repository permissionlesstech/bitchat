        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিকটবর্তী ডিভাইসের সাথে যুক্ত হতে bitchat-এর ব্লুটুথ অনুমতি দরকার। দয়া করে সেটিংসে ব্লুটুথ অ্যাক্সেস সক্রিয় করুন।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "bitchat skal have bluetooth-tilladelse for at forbinde til enheder i nærheden. giv bluetooth-adgang i indstillinger."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "bitchat potřebuje oprávnění k bluetooth, aby se mohl připojit k zařízením poblíž. povol přístup k bluetooth v nastavení."
          }
        },
        "ca" : {
          "stringUnit" : {
