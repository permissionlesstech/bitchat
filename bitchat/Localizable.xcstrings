            "value" : "fixează note în locuri cu /drop, vizibile 24 h pentru oricine trece pe acolo. necesită locație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "закрепляйте заметки в местах с помощью /drop — 24 часа их сможет прочитать любой, кто проходит мимо. нужна геолокация."
          }
        },
        "sr" : {
          "stringUnit" : {
