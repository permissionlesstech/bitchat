          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pinn notizen op plazen mat /drop, déi jiddereen, deen do laanscht kënnt, 24 st. liese kann. brauch de standuert."
          }
        },
        "ms" : {
          "stringUnit" : {
