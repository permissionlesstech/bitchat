          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "• tryk på #mesh for at skifte kanal"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "• klepnutím na #mesh změníš kanál"
          }
