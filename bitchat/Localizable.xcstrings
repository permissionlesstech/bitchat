        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "liga ilhas mesh próximas pela internet para que uma multidão não fique dividida pelo alcance de rádio"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "leagă prin internet insulele mesh din apropiere, ca o mulțime să nu fie despărțită de raza radio"
