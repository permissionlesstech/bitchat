    "location_channels.permission_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض إذن الموقع. فعّله في الإعدادات لاستخدام قنوات الموقع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "разрешението за местоположение е отказано. разреши го в настройките, за да използваш каналите по местоположение."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "дазвол на месцазнаходжанне адхілены. уключы яго ў наладах, каб карыстацца каналамі паводле месца."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লোকেশন অনুমতি অস্বীকৃত। লোকেশন চ্যানেল ব্যবহার করতে সেটিংসে সক্রিয় করুন।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "placeringstilladelse nægtet. slå den til i indstillinger for at bruge lokationskanaler."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "oprávnění k poloze zamítnuto. pro kanály polohy ho povol v nastavení."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "s'ha denegat el permís d'ubicació. activa'l a la configuració per utilitzar els canals d'ubicació."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dozvola za lokaciju odbijena. omogući je u postavkama za korištenje lokacijskih kanala."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "standortberechtigung verweigert. aktiviere sie in den einstellungen für standortkanäle."
          }
        },
        "el" : {
          "stringUnit" : {
