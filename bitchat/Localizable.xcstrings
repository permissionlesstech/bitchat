    "app_info.settings.bridge.no_cell" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد خلية لقاء بعد — يلزم صلاحية الموقع أو قرين جسر قريب"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "все още няма клетка за среща — нужен е достъп до местоположението или близък мостов възел"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "пакуль няма ячэйкі сустрэчы — патрэбны доступ да месцазнаходжання або вузел моста побач"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও কোনো মিলনস্থল সেল নেই — লোকেশন অ্যাক্সেস বা কাছাকাছি একটি ব্রিজ পিয়ার দরকার"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ingen mødecelle endnu — kræver placeringsadgang eller en bro-peer i nærheden"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "zatím žádná buňka setkání — potřebuje přístup k poloze nebo blízký mostní uzel"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "encara no hi ha cel·la de trobada — cal accés a la ubicació o un node pont a prop"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
