    "command.block.done" : {
      "comment" : "Confirmation after blocking a mesh peer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حظر %@. لن ترى رسائل هذا الشخص بعد الآن"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ е блокиран. повече няма да виждаш съобщенията му"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ заблакіраваны. ты больш не ўбачыш яго паведамленняў"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-কে ব্লক করা হলো। এই ব্যক্তির বার্তা আর দেখতে পাবে না"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er blokeret. du ser ikke længere deres beskeder"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ zablokován. jeho zprávy už neuvidíš"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "s'ha bloquejat %@. ja no veuràs els seus missatges"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ blokiran. više nećeš vidjeti njegove poruke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blockiert. du siehst die nachrichten dieser person nicht mehr"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ο/η %@ αποκλείστηκε. δεν θα βλέπεις πια τα μηνύματά του/της"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "blocked %@. you will no longer see their messages"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bloqueado. ya no verás sus mensajes"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ blokeeritud. sa ei näe enam tema sõnumeid"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مسدود شد. دیگر پیام‌های این شخص را نمی‌بینی"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ estetty. et enää näe hänen viestejään"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "na-block si %@. hindi mo na makikita ang mga mensahe niya"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bloqué. tu ne verras plus ses messages"
          }
        },
        "ga" : {
