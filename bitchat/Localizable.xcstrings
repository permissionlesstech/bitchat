          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "asukoha luba keelatud. asukohakanalite kasutamiseks luba see seadetes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی موقعیت رد شد. برای استفاده از کانال‌های موقعیت، آن را در تنظیمات فعال کنید."
          }
        },
        "fi" : {
