    "media.image.delete_confirm_message" : {
      "comment" : "Body of the confirmation dialog before deleting a received image",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن التراجع عن هذا — قد لا يكون المرسِل في النطاق لإرسالها مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "това не може да се отмени — подателят може да не е в обхват, за да го изпрати отново."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "гэта нельга адрабіць — адпраўнік можа не быць у далёкасці, каб адправіць яе зноў."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি ফেরানো যাবে না — প্রেরক আবার পাঠানোর মতো পরিসরে নাও থাকতে পারেন।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dette kan ikke fortrydes — afsenderen er måske ikke inden for rækkevidde til at sende det igen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tohle nejde vrátit zpět — odesílatel nemusí být v dosahu, aby ho poslal znovu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "no es pot desfer — potser el remitent no és a l'abast per tornar-la a enviar."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ovo se ne može poništiti — pošiljalac možda neće biti u dometu da je ponovo pošalje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "das kann nicht rückgängig gemacht werden — der absender ist möglicherweise nicht in reichweite, um es erneut zu senden."
