    "app_info.privacy.ephemeral.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هويتك زوج مفاتيح يُنشأ على هذا الجهاز — المسح الطارئ يستبدلها فورًا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "самоличността ти е двойка ключове, създадена на това устройство — паническото изтриване я заменя мигновено"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "твая асоба — гэта пара ключоў, створаная на гэтай прыладзе — экстранае сціранне імгненна яе замяняе"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পরিচয় এই ডিভাইসে তৈরি একটি কী-জোড়া — প্যানিক ওয়াইপ সঙ্গে সঙ্গে এটি বদলে দেয়"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "din identitet er et nøglepar oprettet på denne enhed — panik-sletning erstatter det øjeblikkeligt"
