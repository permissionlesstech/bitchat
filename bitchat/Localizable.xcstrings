        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "bitchat treba dozvolu za bluetooth kako bi se povezao s uređajima u blizini. omogući pristup bluetoothu u postavkama."
          }
        },
        "de" : {
