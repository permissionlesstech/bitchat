    "app_info.settings.tor.off_warning" : {
      "comment" : "Warning shown under the tor toggle while tor is switched off, stating that relay operators can see the device IP address",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tor متوقف: كل مرحّل تتصل به يمكنه رؤية عنوان IP الخاص بك، بما في ذلك المرحّلات التي تحمل رسائلك الخاصة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor е изключен: всяко реле, с което се свързваш, вижда IP адреса ти, включително релетата, които пренасят личните ти съобщения."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor выключаны: кожны рэтранслятар, да якога ты падключаешся, бачыць твой IP-адрас, у тым ліку тыя, што перадаюць твае асабістыя паведамленні."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tor বন্ধ: আপনি যে রিলেতেই সংযুক্ত হন সেটি আপনার IP ঠিকানা দেখতে পায়, আপনার ব্যক্তিগত বার্তা বহনকারী রিলেগুলোও।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor er slået fra: alle relays, du forbinder til, kan se din IP-adresse, også dem der bærer dine private beskeder."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor je vypnutý: každé relé, ke kterému se připojíš, vidí tvou IP adresu, včetně relé, která přenášejí tvé soukromé zprávy."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor està desactivat: cada relé al qual et connectes pot veure la teva adreça IP, inclosos els que porten els teus missatges privats."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor je isključen: svaki relej s kojim se povežeš vidi tvoju IP adresu, uključujući releje koji prenose tvoje privatne poruke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tor ist aus: jedes relay, mit dem du dich verbindest, kann deine ip-adresse sehen, auch die relays, die deine privaten nachrichten tragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "το tor είναι ανενεργό: κάθε αναμεταδότης στον οποίο συνδέεσαι βλέπει τη διεύθυνση IP σου, μαζί και όσοι μεταφέρουν τα ιδιωτικά σου μηνύματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tor is off: every relay you connect to can see your IP address, including relays carrying your private messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tor está desactivado: cada relay al que te conectas puede ver tu dirección IP, incluidos los relays que llevan tus mensajes privados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor on väljas: iga relee, millega ühendud, näeb sinu IP-aadressi, ka need, mis sinu privaatsõnumeid edastavad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tor خاموش است: هر رله‌ای که به آن وصل می‌شوید می‌تواند نشانی IP شما را ببیند، از جمله رله‌هایی که پیام‌های خصوصی شما را می‌برند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tor on pois päältä: jokainen välityspalvelin, johon yhdistät, näkee IP-osoitteesi, myös yksityisviestejäsi välittävät."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "naka-off ang tor: nakikita ng bawat relay na kinokonekta mo ang iyong IP address, kasama ang mga relay na nagdadala ng iyong mga pribadong mensahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tor est désactivé : chaque relais auquel tu te connectes voit ton adresse ip, y compris les relais qui transportent tes messages privés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tá tor múchta: feiceann gach athsheachadán a gceanglaíonn tú leis do sheoladh IP, lena n-áirítear na cinn a iompraíonn do theachtaireachtaí príobháideacha."
          }
        },
        "he" : {
