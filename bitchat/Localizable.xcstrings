    "command.help.text" : {
      "comment" : "The /help reference list; command syntax stays verbatim, only the descriptions after each dash are translated",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوامر:\n/msg @name [message] — بدء محادثة خاصة\n/who — عرض من هنا\n/clear — مسح هذه المحادثة\n/hug @name — إرسال عناق\n/slap @name — صفعة بسمكة تراوت ضخمة\n/block @name · /unblock @name\n/fav @name · /unfav @name — المفضلة (mesh فقط)\n/group create <name> — إنشاء مجموعة مشفّرة\n/group invite @name · /group remove @name — إدارة الأعضاء (المنشئ)\n/group leave · /group list — مغادرة مجموعاتك أو عرضها\n/ping @name — قياس زمن الذهاب والإياب (mesh فقط)\n/trace @name — مسار mesh المقدّر (mesh فقط)\n/pay <token> — إرسال رمز cashu (ecash) في هذه المحادثة\n/drop <message> — تثبيت ملاحظة في هذا المكان لمدة 24 ساعة (يحتاج إلى الموقع)\n/help — هذه القائمة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "команди:\n/msg @name [съобщение] — започни личен чат\n/who — покажи кой е тук\n/clear — изчисти този чат\n/hug @name — изпрати прегръдка\n/slap @name — плесни с голяма пъстърва\n/block @name · /unblock @name\n/fav @name · /unfav @name — любими (само mesh)\n/group create <име> — създай шифрована група\n/group invite @name · /group remove @name — управлявай членовете (създател)\n/group leave · /group list — напусни или покажи групите си\n/ping @name — измери времето за отговор (само mesh)\n/trace @name — приблизителен mesh маршрут (само mesh)\n/pay <token> — изпрати cashu ecash токен в този чат\n/drop <съобщение> — закачи бележка на това място за 24 ч (нужно е местоположение)\n/help — този списък"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "каманды:\n/msg @name [паведамленне] — пачаць асабісты чат\n/who — паказаць, хто тут\n/clear — ачысціць гэты чат\n/hug @name — адправіць абдымкі\n/slap @name — пляснуць вялікім фарэлем\n/block @name · /unblock @name\n/fav @name · /unfav @name — абранае (толькі mesh)\n/group create <назва> — стварыць зашыфраваную групу\n/group invite @name · /group remove @name — кіраваць удзельнікамі (стваральнік)\n/group leave · /group list — пакінуць або паказаць свае групы\n/ping @name — вымераць час водгуку (толькі mesh)\n/trace @name — ацэначны mesh-маршрут (толькі mesh)\n/pay <token> — адправіць cashu ecash токен у гэтым чаце\n/drop <паведамленне> — замацаваць нататку на гэтым месцы на 24 г (патрэбна месцазнаходжанне)\n/help — гэты спіс"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কমান্ড:\n/msg @name [message] — প্রাইভেট চ্যাট শুরু করো\n/who — কে কে আছে দেখো\n/clear — এই চ্যাট মুছে ফেলো\n/hug @name — একটা আলিঙ্গন পাঠাও\n/slap @name — বিশাল এক ট্রাউট মাছ দিয়ে চড় মারো\n/block @name · /unblock @name\n/fav @name · /unfav @name — প্রিয় তালিকা (শুধু mesh)\n/group create <name> — এনক্রিপ্ট করা গ্রুপ শুরু করো\n/group invite @name · /group remove @name — সদস্য ব্যবস্থাপনা (নির্মাতা)\n/group leave · /group list — গ্রুপ ছাড়ো বা তালিকা দেখো\n/ping @name — রাউন্ড-ট্রিপ সময় মাপো (শুধু mesh)\n/trace @name — আনুমানিক mesh পথ (শুধু mesh)\n/pay <token> — এই চ্যাটে একটি cashu ecash টোকেন পাঠাও\n/drop <message> — এই জায়গায় ২৪ ঘণ্টার জন্য একটা নোট আটকে দাও (লোকেশন লাগবে)\n/help — এই তালিকা"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kommandoer:\n/msg @name [besked] — start en privat chat\n/who — vis hvem der er her\n/clear — ryd denne chat\n/hug @name — send et kram\n/slap @name — giv en lussing med en stor ørred\n/block @name · /unblock @name\n/fav @name · /unfav @name — favoritter (kun mesh)\n/group create <navn> — start en krypteret gruppe\n/group invite @name · /group remove @name — administrer medlemmer (opretter)\n/group leave · /group list — forlad eller vis dine grupper\n/ping @name — mål svartid (kun mesh)\n/trace @name — anslået mesh-rute (kun mesh)\n/pay <token> — send et cashu-ecash-token i denne chat\n/drop <besked> — fastgør en note til dette sted i 24 t (kræver placering)\n/help — denne liste"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "příkazy:\n/msg @name [zpráva] — zahájit soukromý chat\n/who — ukázat, kdo je tady\n/clear — vymazat tento chat\n/hug @name — poslat objetí\n/slap @name — plácnout velkým pstruhem\n/block @name · /unblock @name\n/fav @name · /unfav @name — oblíbené (jen mesh)\n/group create <název> — založit šifrovanou skupinu\n/group invite @name · /group remove @name — spravovat členy (zakladatel)\n/group leave · /group list — opustit nebo vypsat své skupiny\n/ping @name — změřit dobu odezvy (jen mesh)\n/trace @name — odhadovaná mesh trasa (jen mesh)\n/pay <token> — poslat cashu ecash token v tomto chatu\n/drop <zpráva> — připnout poznámku k tomuto místu na 24 h (vyžaduje polohu)\n/help — tento seznam"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
