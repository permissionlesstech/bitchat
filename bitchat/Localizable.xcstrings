    "notices.description.mesh" : {
      "comment" : "Explainer for the mesh tab of the notices sheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت إعلانات قصيرة لمن حولك. تنتقل من هاتف إلى هاتف حتى دون اتصال، وتختفي وحدها بعد أيام قليلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "закачи кратки обяви за хората около теб. те прескачат от телефон на телефон дори без мрежа и изчезват сами след няколко дни."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "замацоўвай кароткія аб’явы для людзей вакол. яны пераходзяць з тэлефона на тэлефон нават без сеткі і самі знікаюць праз некалькі дзён."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আশেপাশের মানুষের জন্য ছোট নোটিশ পিন করুন। অফলাইনেও ফোন থেকে ফোনে পৌঁছে যায় আর কয়েক দিন পরে নিজে থেকেই মুছে যায়।"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fastgør korte opslag til folk omkring dig. de hopper fra telefon til telefon, selv offline, og forsvinder af sig selv efter nogle dage."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "připínej krátká oznámení pro lidi kolem sebe. přeskakují z telefonu na telefon i offline a po pár dnech samy zmizí."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fixa avisos breus per a la gent del teu voltant. passen de telèfon en telèfon, fins i tot fora de línia, i desapareixen sols al cap d'uns quants dies."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "zakači kratke obavijesti za ljude oko sebe. skaču s telefona na telefon čak i izvan mreže i nestaju same nakon nekoliko dana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hefte kurze hinweise für leute in deiner nähe an. sie springen von handy zu handy, auch offline, und verschwinden nach ein paar tagen von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "καρφίτσωσε σύντομες ανακοινώσεις για όσους είναι γύρω σου. περνούν από τηλέφωνο σε τηλέφωνο, ακόμη και εκτός σύνδεσης, και εξαφανίζονται μόνες τους μετά από λίγες μέρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pin short notices for people around you. they hop phone to phone, even offline, and disappear on their own after a few days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fija avisos cortos para la gente cercana. saltan de teléfono a teléfono, incluso sin conexión, y desaparecen solos después de unos días."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kinnita lühikesi teateid enda ümber olevatele inimestele. need liiguvad telefonist telefoni isegi võrguühenduseta ja kaovad mõne päeva pärast iseenesest."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلاعیه‌های کوتاه برای اطرافیان‌تان سنجاق کنید. گوشی به گوشی جابه‌جا می‌شوند، حتی آفلاین، و بعد از چند روز خودبه‌خود ناپدید می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "kiinnitä lyhyitä ilmoituksia ympärilläsi oleville. ne hyppäävät puhelimesta toiseen jopa ilman verkkoa ja katoavat itsestään muutaman päivän kuluttua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mag-pin ng maiikling paunawa para sa mga taong nasa paligid mo. lumilipat ito mula sa isang telepono patungo sa iba, kahit offline, at kusang nawawala pagkatapos ng ilang araw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "épingle de courtes annonces pour les gens autour de toi. elles passent de téléphone en téléphone, même hors ligne, et disparaissent d'elles-mêmes après quelques jours."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pionnáil fógraí gearra do dhaoine thart timpeall ort. téann siad ó ghuthán go guthán, fiú as líne, agus imíonn siad as féin tar éis cúpla lá."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצמד מודעות קצרות לאנשים סביבך. הן עוברות מטלפון לטלפון, גם בלי אינטרנט, ונעלמות מעצמן אחרי כמה ימים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आस-पास के लोगों के लिए छोटी सूचनाएँ पिन करें। ये ऑफ़लाइन भी फ़ोन से फ़ोन तक पहुँचती हैं और कुछ दिनों बाद अपने आप मिट जाती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tűzz ki rövid hirdetményeket a körülötted lévőknek. telefonról telefonra jutnak, akár offline is, és néhány nap után maguktól eltűnnek."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "prikvači kratke obavijesti za ljude oko sebe. skaču s telefona na telefon čak i izvan mreže i nestaju same nakon nekoliko dana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sematkan pengumuman singkat untuk orang di sekitarmu. berpindah dari ponsel ke ponsel, bahkan saat offline, dan hilang sendiri setelah beberapa hari."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "festu stuttar tilkynningar fyrir fólk í kringum þig. þær hoppa frá síma til síma, jafnvel án nets, og hverfa af sjálfu sér eftir nokkra daga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "appunta brevi avvisi per chi ti sta intorno. passano da telefono a telefono, anche offline, e spariscono da soli dopo qualche giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの人に向けて短いお知らせをピン留め。オフラインでもスマホからスマホへ伝わり、数日後に自動的に消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 사람들을 위해 짧은 공지를 고정하세요. 오프라인에서도 휴대폰에서 휴대폰으로 전달되고 며칠 후 스스로 사라집니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "закачи кратки известувања за луѓето околу тебе. тие скокаат од телефон на телефон дури и без мрежа и исчезнуваат сами по неколку дена."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "piesprauž īsus paziņojumus cilvēkiem sev apkārt. tie lēkā no tālruņa uz tālruni pat bezsaistē un pēc dažām dienām pazūd paši."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "prisek trumpus skelbimus aplinkiniams žmonėms. jie šokinėja iš telefono į telefoną net be ryšio ir po kelių dienų išnyksta patys."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pinn kuerz matdeelunge fir d'leit ronderëm dech. si ginn vun telefon zu telefon, och offline, a verschwannen no e puer deeg vu selwer."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "semat pengumuman ringkas untuk orang di sekeliling anda. ia berpindah dari telefon ke telefon, walaupun di luar talian, dan hilang sendiri selepas beberapa hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fest korte oppslag for folk rundt deg. de hopper fra telefon til telefon, selv uten nett, og forsvinner av seg selv etter noen dager."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "waħħal avviżi qosra għan-nies ta' madwarek. jgħaddu minn telefon għal telefon, anke offline, u jisparixxu waħedhom wara ftit jiem."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वरपरका मानिसहरूका लागि छोटा सूचना पिन गर। अफलाइनमा पनि फोनबाट फोनमा पुग्छन् र केही दिनपछि आफैँ हराउँछन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "prik korte mededelingen voor mensen om je heen. ze springen van telefoon naar telefoon, ook offline, en verdwijnen vanzelf na een paar dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "przypinaj krótkie ogłoszenia dla ludzi w pobliżu. przeskakują z telefonu na telefon, nawet offline, i same znikają po kilku dniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "afixa avisos curtos para quem está por perto. saltam de telemóvel em telemóvel, mesmo offline, e desaparecem sozinhos após alguns dias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fixe avisos curtos para as pessoas por perto. eles pulam de celular em celular, mesmo offline, e somem sozinhos depois de alguns dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fixează anunțuri scurte pentru oamenii din jur. trec din telefon în telefon, chiar și offline, și dispar singure după câteva zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "закрепляй короткие объявления для людей рядом. они передаются с телефона на телефон, даже офлайн, и сами исчезают через несколько дней."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "закачи кратка обавештења за људе око себе. скачу са телефона на телефон чак и ван мреже и нестају сама после неколико дана."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "fikso njoftime të shkurtra për njerëzit përreth teje. kalojnë nga telefoni në telefon, edhe jashtë linje, dhe zhduken vetë pas disa ditësh."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pripni kratka obvestila za ljudi okoli sebe. skačejo s telefona na telefon tudi brez povezave in po nekaj dneh same izginejo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "pripínaj krátke oznámenia pre ľudí okolo seba. preskakujú z telefónu na telefón aj offline a po pár dňoch samy zmiznú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nåla upp korta anslag för folk i närheten. de hoppar från telefon till telefon, även offline, och försvinner av sig själva efter några dagar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அருகிலுள்ளவர்களுக்காக சிறிய அறிவிப்புகளைப் பின் செய்யவும். ஆஃப்லைனிலும் ஃபோனிலிருந்து ஃபோனுக்குப் பரவி, சில நாட்களில் தானாக மறைந்துவிடும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปักประกาศสั้น ๆ ให้คนรอบตัว ส่งต่อจากมือถือสู่มือถือได้แม้ออฟไลน์ และหายไปเองหลังผ่านไปสองสามวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "çevrendekiler için kısa duyurular sabitle. çevrimdışıyken bile telefondan telefona geçer ve birkaç gün sonra kendiliğinden kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "закріплюй короткі оголошення для людей поруч. вони передаються з телефона на телефон, навіть офлайн, і самі зникають за кілька днів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آس پاس کے لوگوں کیلئے مختصر اعلانات پن کریں۔ یہ آف لائن بھی فون سے فون تک پہنچتے ہیں اور کچھ دنوں بعد خود مٹ جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ghim thông báo ngắn cho những người quanh bạn. chúng truyền từ điện thoại này sang điện thoại khác, kể cả khi ngoại tuyến, và tự biến mất sau vài ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为周围的人钉上简短公告。即使离线也能在手机间传递，几天后自动消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為周圍的人釘上簡短公告。即使離線也能在手機間傳遞，幾天後自動消失。"
          }
        }
      }
    },
